{
  "name": "AnalyticsEvent",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "value_usd": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "created_by_id": {
      "type": "string"
    },
    "required": [
    "name"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}