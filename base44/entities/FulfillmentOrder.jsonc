{
  "name": "FulfillmentOrder",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "tenant_owner_email": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "order_id": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "fulfillment_number": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "local_seller",
        "local_warehouse",
        "international_supplier"
      ],
      "default": "local_seller"
    },
    "seller_id": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "seller_email": {
      "type": "string"
    },
    "supplier_id": {
      "type": "string"
    },
    "supplier_name": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "subtotal_usd": {
      "type": "number",
      "default": 0
    },
    "shipping_usd": {
      "type": "number",
      "default": 0
    },
    "supplier_cost_usd": {
      "type": "number",
      "default": 0
    },
    "seller_payout_usd": {
      "type": "number",
      "default": 0
    },
    "creator_commission_usd": {
      "type": "number",
      "default": 0
    },
    "platform_revenue_usd": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "CONFIRMED",
        "PROCESSING",
        "READY_FOR_PICKUP",
        "PICKED_UP",
        "IN_TRANSIT",
        "OUT_FOR_DELIVERY",
        "DELIVERED",
        "FAILED",
        "RETURNED",
        "CANCELLED"
      ],
      "default": "PENDING"
    },
    "courier_id": {
      "type": "string"
    },
    "courier_name": {
      "type": "string"
    },
    "courier_email": {
      "type": "string"
    },
    "tracking_number": {
      "type": "string"
    },
    "estimated_delivery": {
      "type": "string"
    },
    "payout_released": {
      "type": "boolean",
      "default": false
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "order_id",
    "fulfillment_number"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.seller_email": "{{user.email}}"
        },
        {
          "data.courier_email": "{{user.email}}"
        },
        {
          "data.tenant_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}