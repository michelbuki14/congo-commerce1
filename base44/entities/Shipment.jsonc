{
  "name": "Shipment",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "tenant_owner_email": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "fulfillment_order_id": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "courier_id": {
      "type": "string"
    },
    "courier_name": {
      "type": "string"
    },
    "courier_email": {
      "type": "string"
    },
    "tracking_number": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "PENDING"
    },
    "courier_response": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "default": "pending"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "proof_of_delivery": {
      "type": "string"
    },
    "delivered_to": {
      "type": "string"
    },
    "delivered_at": {
      "type": "string"
    }
  },
  "required": [
    "order_number"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.courier_email": "{{user.email}}"
        },
        {
          "data.tenant_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "created_by_id": {
      "type": "string"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}