{
  "name": "Shipment",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "tenant_owner_email": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "fulfillment_order_id": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "courier_id": {
      "type": "string"
    },
    "courier_name": {
      "type": "string"
    },
    "tracking_number": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "PENDING"
    },
    "courier_response": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "default": "pending"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "proof_of_delivery": {
      "type": "string"
    },
    "delivered_to": {
      "type": "string"
    },
    "delivered_at": {
      "type": "string"
    }
  },
  "required": [
    "order_number"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": null,
    "update": null,
    "delete": { "user_condition": { "role": "admin" } }
  }
}