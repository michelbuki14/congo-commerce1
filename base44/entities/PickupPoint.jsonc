{
  "name": "PickupPoint",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "commune": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "hours": {
      "type": "string",
      "default": "08:00 - 18:00"
    },
    "fee_usd": {
      "type": "number",
      "default": 0.5
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "city"
  ]
}