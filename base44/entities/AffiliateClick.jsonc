{
  "name": "AffiliateClick",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "creator_id": {
      "type": "string"
    },
    "creator_name": {
      "type": "string"
    },
    "referral_code": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "product_title": {
      "type": "string"
    },
    "converted": {
      "type": "boolean",
      "default": false
    },
    "order_number": {
      "type": "string"
    },
    "commission_usd": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "referral_code"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}