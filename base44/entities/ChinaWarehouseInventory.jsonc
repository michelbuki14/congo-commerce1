{
  "name": "ChinaWarehouseInventory",
  "type": "object",
  "properties": {
    "tenant_id": { "type": "string" },
    "tenant_owner_email": { "type": "string" },
    "warehouse_id": { "type": "string" },
    "warehouse_name": { "type": "string" },
    "product_id": { "type": "string" },
    "product_title": { "type": "string" },
    "sku": { "type": "string" },
    "supplier_id": { "type": "string" },
    "supplier_name": { "type": "string" },
    "quantity_on_hand": { "type": "number", "default": 0 },
    "quantity_reserved": { "type": "number", "default": 0 },
    "quantity_in_transit": { "type": "number", "default": 0 },
    "quantity_available": { "type": "number", "default": 0 },
    "location": { "type": "string", "description": "Shelf/bin location in warehouse" },
    "cost_usd": { "type": "number", "default": 0 },
    "moq": { "type": "number", "default": 1 },
    "lead_time_days": { "type": "number", "default": 14 },
    "last_receipt_at": { "type": "string" },
    "active": { "type": "boolean", "default": true }
  },
  "created_by_id": {
      "type": "string"
    },
    "required": ["warehouse_id", "product_id", "sku"],
  "rls": {
    "read": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "data.tenant_owner_email": "{{user.email}}" }
      ]
    },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
