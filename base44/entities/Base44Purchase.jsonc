{
  "name": "Base44Purchase",
  "type": "object",
  "properties": {
    "checkoutSessionId": {
      "type": "string",
      "description": "Wix checkout session id; correlation key."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "canceled"
      ],
      "default": "pending"
    },
    "orderId": {
      "type": "string",
      "description": "Wix order id, filled in by the webhook."
    },
    "appUserId": {
      "type": "string",
      "description": "Base44 app user who initiated checkout."
    },
    "buyerEmail": {
      "type": "string"
    },
    "productId": {
      "type": "string"
    },
    "productName": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "amount": {
      "type": "string",
      "description": "Charged amount in major units, e.g. \"19.99\"."
    },
    "currency": {
      "type": "string"
    },
    "subscriptionId": {
      "type": "string"
    },
    "paidAt": {
      "type": "string",
      "format": "date-time"
    },
    "canceledAt": {
      "type": "string",
      "format": "date-time"
    },
    "tenant_id": {
      "type": "string"
    },
    "tenant_owner_email": {
      "type": "string"
    }
  },
  "required": [
    "checkoutSessionId",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}