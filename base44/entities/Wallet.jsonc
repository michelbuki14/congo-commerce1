{
  "name": "Wallet",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "tenant_owner_email": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "owner_type": {
      "type": "string",
      "enum": [
        "customer",
        "seller",
        "creator",
        "courier",
        "platform"
      ],
      "default": "customer"
    },
    "owner_id": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "created_by_id": {
      "type": "string",
      "description": "User who owns this wallet"
    },
    "balance_usd": {
      "type": "number",
      "default": 0
    },
    "balance_cdf": {
      "type": "number",
      "default": 0
    },
    "pending_usd": {
      "type": "number",
      "default": 0
    },
    "lifetime_credit_usd": {
      "type": "number",
      "default": 0
    },
    "lifetime_debit_usd": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "frozen"
      ],
      "default": "active"
    }
  },
  "required": [
    "owner_type",
    "owner_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "data.tenant_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.owner_type": "seller",
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}