{
  "name": "Review",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "tenant_owner_email": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "product_id": {
      "type": "string"
    },
    "product_title": {
      "type": "string"
    },
    "seller_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 5
    },
    "comment": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verified_purchase": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "hidden"
      ],
      "default": "published"
    }
  },
  "created_by_id": {
      "type": "string"
    },
    "required": [
    "product_id",
    "rating"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": { "user_condition": { "role": { "$in": ["admin", "user"] } } },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}