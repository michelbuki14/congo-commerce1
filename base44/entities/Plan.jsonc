{
  "name": "Plan",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price_monthly_usd": {
      "type": "number",
      "default": 0
    },
    "price_yearly_usd": {
      "type": "number",
      "default": 0
    },
    "trial_days": {
      "type": "number",
      "default": 14
    },
    "product_limit": {
      "type": "number",
      "default": 50
    },
    "store_limit": {
      "type": "number",
      "default": 1
    },
    "seller_limit": {
      "type": "number",
      "default": 3
    },
    "member_limit": {
      "type": "number",
      "default": 3
    },
    "commission_rate": {
      "type": "number",
      "default": 12
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "highlighted": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "code",
    "name"
  ],
  "rls": {
    "read": null,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}