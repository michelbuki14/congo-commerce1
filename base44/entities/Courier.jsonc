{
  "name": "Courier",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "adapter": {
      "type": "string",
      "default": "mock_courier"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "service_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "base_rate_usd": {
      "type": "number",
      "default": 3
    },
    "per_kg_usd": {
      "type": "number",
      "default": 1
    },
    "avg_days": {
      "type": "number",
      "default": 3
    },
    "supports_tracking": {
      "type": "boolean",
      "default": true
    },
    "supports_cod": {
      "type": "boolean",
      "default": true
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "is_mock": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}