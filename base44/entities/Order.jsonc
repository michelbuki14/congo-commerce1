{
  "name": "Order",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "tenant_owner_email": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "payment_phone": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "delivery_method": {
      "type": "string",
      "enum": [
        "home_delivery",
        "pickup_point"
      ],
      "default": "home_delivery"
    },
    "pickup_point_id": {
      "type": "string"
    },
    "pickup_point_name": {
      "type": "string"
    },
    "pickup_code": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "subtotal_usd": {
      "type": "number",
      "default": 0
    },
    "shipping_usd": {
      "type": "number",
      "default": 0
    },
    "discount_usd": {
      "type": "number",
      "default": 0
    },
    "total_usd": {
      "type": "number",
      "default": 0
    },
    "total_cdf": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "payment_method": {
      "type": "string"
    },
    "payment_provider": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "AUTHORIZED",
        "PAID",
        "FAILED",
        "REFUNDED",
        "PARTIALLY_REFUNDED",
        "CANCELLED"
      ],
      "default": "PENDING"
    },
    "payment_reference": {
      "type": "string"
    },
    "payment_verified": {
      "type": "boolean",
      "default": false
    },
    "coupon_code": {
      "type": "string"
    },
    "affiliate_code": {
      "type": "string"
    },
    "creator_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "CONFIRMED",
        "PROCESSING",
        "SHIPPED",
        "DELIVERED",
        "CANCELLED"
      ],
      "default": "PENDING"
    },
    "fulfillment_count": {
      "type": "number",
      "default": 0
    },
    "vat_rate": {
      "type": "number",
      "default": 0
    },
    "vat_usd": {
      "type": "number",
      "default": 0
    },
    "total_ht_usd": {
      "type": "number",
      "default": 0
    },
    "invoice_number": {
      "type": "string"
    },
    "consent_terms": {
      "type": "boolean",
      "default": false
    },
    "consent_marketing": {
      "type": "boolean",
      "default": false
    },
    "consent_at": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "archived_at": {
      "type": "string"
    }
  },
  "required": [
    "order_number"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}