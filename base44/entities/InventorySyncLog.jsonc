{
  "name": "InventorySyncLog",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "source_id": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "trigger": {
      "type": "string",
      "enum": [
        "manual",
        "scheduled"
      ],
      "default": "scheduled"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed"
      ],
      "default": "success"
    },
    "rows": {
      "type": "number",
      "default": 0
    },
    "updated": {
      "type": "number",
      "default": 0
    },
    "unmatched_count": {
      "type": "number",
      "default": 0
    },
    "error": {
      "type": "string"
    },
    "duration_ms": {
      "type": "number",
      "default": 0
    }
  },
  "created_by_id": {
      "type": "string"
    },
    "required": [
    "source_name",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}