{
  "name": "Notification",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "tenant_owner_email": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "order",
        "promo",
        "system",
        "payment",
        "social"
      ],
      "default": "system"
    },
    "audience": {
      "type": "string",
      "enum": [
        "customer",
        "seller",
        "admin"
      ],
      "default": "customer"
    },
    "order_number": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "created_by_id": {
      "type": "string"
    },
    "required": [
    "title"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": { "$in": ["admin", "user"] } } },
    "update": null,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}