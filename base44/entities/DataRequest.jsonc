{
  "name": "DataRequest",
  "type": "object",
  "properties": {
    "request_number": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "access",
        "rectification",
        "deletion",
        "opposition"
      ],
      "default": "access"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "verification_sent",
        "verified",
        "in_progress",
        "ready",
        "completed",
        "rejected"
      ],
      "default": "received"
    },
    "resolution_notes": {
      "type": "string"
    },
    "verification_token": {
      "type": "string"
    },
    "verification_sent_at": {
      "type": "string"
    },
    "verified_at": {
      "type": "string"
    },
    "notified_compliance_at": {
      "type": "string"
    },
    "report_sent_at": {
      "type": "string"
    },
    "email_status": {
      "type": "string",
      "enum": [
        "sent",
        "failed",
        "skipped"
      ]
    },
    "email_error": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "name"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}