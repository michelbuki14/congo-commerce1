{
  "name": "Return",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "tenant_owner_email": {
      "type": "string"
    },
    "return_number": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "product_title": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "not_received",
        "wrong_product",
        "damaged",
        "not_as_described",
        "missing_item",
        "changed_mind"
      ],
      "default": "not_received"
    },
    "description": {
      "type": "string"
    },
    "evidence_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "refund_amount_usd": {
      "type": "number",
      "default": 0
    },
    "resolution_notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "under_review",
        "approved",
        "rejected",
        "return_in_transit",
        "refunded",
        "closed"
      ],
      "default": "requested"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "order_number",
    "reason"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.tenant_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.tenant_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}