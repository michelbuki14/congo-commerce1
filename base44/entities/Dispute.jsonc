{
  "name": "Dispute",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "tenant_owner_email": {
      "type": "string"
    },
    "created_by_id": {
      "type": "string",
      "description": "User who created the dispute"
    },
    "order_number": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "not_received",
        "wrong_product",
        "damaged",
        "not_as_described",
        "missing_item",
        "payment_issue"
      ],
      "default": "not_received"
    },
    "description": {
      "type": "string"
    },
    "amount_usd": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "investigating",
        "resolved_buyer",
        "resolved_seller",
        "escalated",
        "closed"
      ],
      "default": "open"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high"
      ],
      "default": "normal"
    },
    "admin_notes": {
      "type": "string"
    },
    "proof_of_delivery": {
      "type": "string"
    },
    "proof_uploaded_at": {
      "type": "string"
    },
    "proof_uploaded_by": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "order_number",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.tenant_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.tenant_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}