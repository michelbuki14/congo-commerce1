{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "thread_id": {
      "type": "string"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "customer",
        "seller",
        "support"
      ]
    },
    "sender_name": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "created_by_id": {
      "type": "string"
    },
    "required": [
    "thread_id",
    "sender_role",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.participants": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.participants": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}