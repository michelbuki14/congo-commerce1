{
  "name": "WalletTransaction",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "tenant_owner_email": {
      "type": "string"
    },
    "wallet_id": {
      "type": "string"
    },
    "owner_type": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "CREDIT",
        "DEBIT",
        "REFUND",
        "COMMISSION",
        "PAYOUT",
        "ADJUSTMENT"
      ],
      "default": "CREDIT"
    },
    "direction": {
      "type": "string",
      "enum": [
        "credit",
        "debit"
      ],
      "default": "credit"
    },
    "amount_usd": {
      "type": "number",
      "default": 0
    },
    "amount_cdf": {
      "type": "number",
      "default": 0
    },
    "balance_after_usd": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "description": {
      "type": "string"
    },
    "reference": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "posted",
        "pending",
        "reversed"
      ],
      "default": "posted"
    }
  },
  "required": [
    "wallet_id",
    "type",
    "amount_usd"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "data.tenant_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}