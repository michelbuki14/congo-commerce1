{
  "name": "PlatformEvent",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "order",
        "seller",
        "catalogue",
        "account",
        "risk",
        "system"
      ],
      "default": "system"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "default": "info"
    },
    "source": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "reference": {
      "type": "string"
    },
    "actor_email": {
      "type": "string"
    },
    "actor_name": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "tenant_owner_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "handled",
        "failed"
      ],
      "default": "received"
    },
    "handled_at": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "payload": {
      "type": "object"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "created_by_id": {
      "type": "string"
    },
    "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}