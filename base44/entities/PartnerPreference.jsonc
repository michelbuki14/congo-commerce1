{
  "name": "PartnerPreference",
  "type": "object",
  "properties": {
    "key": { "type": "string", "enum": ["partner_ai", "inventory_alerts"] },
    "value": { "type": "object" },
    "description": { "type": "string", "maxLength": 1000 },
    "created_by_id": { "type": "string", "description": "User who created the preference" }
  },
  "required": ["key"],
  "rls": {
    "create": {
      "$or": [
        { "data.created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "read": {
      "$or": [
        { "data.created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "data.created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "data.created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}
