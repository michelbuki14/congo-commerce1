{
  "name": "ShippingLabel",
  "type": "object",
  "properties": {
    "tenant_id": { "type": "string" },
    "tenant_owner_email": { "type": "string" },
    "label_id": { "type": "string" },
    "order_number": { "type": "string" },
    "fulfillment_number": { "type": "string" },
    "carrier": { "type": "string", "enum": ["congo_courier", "dhl", "fedex", "ups", "china_post", "ems", "custom"] },
    "tracking_number": { "type": "string" },
    "status": { "type": "string", "enum": ["pending", "generated", "printed", "in_transit", "delivered", "returned"], "default": "pending" },
    "label_data": { "type": "string", "description": "Base64-encoded label PDF/image" },
    "label_url": { "type": "string", "description": "URL to generated label file" },
    "sender": { "type": "object", "properties": { "name": { "type": "string" }, "address": { "type": "string" }, "city": { "type": "string" }, "country": { "type": "string" }, "phone": { "type": "string" } } },
    "recipient": { "type": "object", "properties": { "name": { "type": "string" }, "address": { "type": "string" }, "city": { "type": "string" }, "country": { "type": "string" }, "phone": { "type": "string" }, "email": { "type": "string" } } },
    "package": { "type": "object", "properties": { "weight_kg": { "type": "number" }, "length_cm": { "type": "number" }, "width_cm": { "type": "number" }, "height_cm": { "type": "number" }, "items_count": { "type": "number" } } },
    "shipping_cost_usd": { "type": "number", "default": 0 },
    "generated_at": { "type": "string" },
    "printed_at": { "type": "string" }
  },
  "created_by_id": {
      "type": "string"
    },
    "required": ["order_number", "label_id"],
  "rls": {
    "read": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "data.tracking_number": "{{user.email}}" }
      ]
    },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
