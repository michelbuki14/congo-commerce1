{
  "name": "FraudRule",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "signal": {
      "type": "string"
    },
    "threshold": {
      "type": "number",
      "default": 1
    },
    "score": {
      "type": "number",
      "default": 10
    },
    "action": {
      "type": "string",
      "enum": [
        "review",
        "block"
      ],
      "default": "review"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "created_by_id": {
      "type": "string"
    },
    "required": [
    "code",
    "label",
    "signal"
  ],
  "rls": {
    "read": { "user_condition": { "role": "admin" } },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}